{
  "name": "blinkbreak",
  "version": "1.1.0",
  "author": "KSquare",
  "private": true,
  "type": "module",
  "description": "A privacy-first adaptive eye-break extension for Chromium browsers.",
  "scripts": {
    "dev": "node scripts/watch-extension.mjs",
    "dev:ui": "vite",
    "build": "node scripts/build-extension.mjs",
    "verify:dist": "node scripts/validate-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package-extension.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-wasm32-wasi": "^1.2.6",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
